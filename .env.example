# Copy to .env.local for local development. Never commit real values.

# Firebase web app config (Project settings → Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=chokdee-online-project
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Public site URL used for canonical / OG / sitemap references in app
VITE_SITE_URL=https://black-construction.web.app

# Optional: Google Analytics measurement ID (wire via gtag snippet if needed)
# VITE_GA_MEASUREMENT_ID=
